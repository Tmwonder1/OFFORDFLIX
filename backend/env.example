# OnStream TV Backend Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# TMDB API Configuration (Required for movie/TV data)
TMDB_API_KEY=your_tmdb_api_key_here

# Database Configuration (Optional - uses in-memory storage if not set)
DATABASE_URL=
MONGODB_URL=
REDIS_URL=

# JWT Configuration (Optional - uses simple tokens if not set)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:*,https://cinepro.mintlify.app

# Cache Configuration
CACHE_TTL=10800
CACHE_MAX_SIZE=1000

# Logging
LOG_LEVEL=info
ENABLE_ACCESS_LOGS=true

# Features
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTS=true
ENABLE_DEBUG_MODE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=your_session_secret_here

# External Services
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# Streaming Providers (Optional overrides)
VIDSRC_ENABLED=true
TWOEMBED_ENABLED=true
AUTOEMBED_ENABLED=true
PRIMEWIRE_ENABLED=true

# Content Filtering
ENABLE_ADULT_CONTENT=false
DEFAULT_LANGUAGE=en
DEFAULT_REGION=US


