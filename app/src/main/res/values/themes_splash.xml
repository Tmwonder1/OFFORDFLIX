<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Screen Theme for Android 12+ -->
    <style name="Theme.Offordflix.Splash" parent="Theme.SplashScreen">
        <!-- Background color -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        
        <!-- Splash screen icon -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        
        <!-- Icon background (if needed) -->
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        
        <!-- Brand image (optional) -->
        <item name="android:windowSplashScreenBrandingImage">@drawable/app_banner</item>
        
        <!-- Status bar and navigation bar colors -->
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        
        <!-- Light status bar icons (false for dark background) -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Post splash screen theme -->
        <item name="postSplashScreenTheme">@style/Theme.Offordflix</item>
    </style>
    
    <!-- TV-optimized splash theme -->
    <style name="Theme.Offordflix.Splash.TV" parent="Theme.Offordflix.Splash">
        <!-- Remove action bar for TV -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        
        <!-- Fullscreen for TV -->
        <item name="android:windowFullscreen">true</item>
        
        <!-- TV-specific optimizations -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>


