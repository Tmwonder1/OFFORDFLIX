<?xml version="1.0" encoding="utf-8"?>
<!-- Example hero banner layout using the left scrim gradient overlay -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="600dp">

    <!-- Background image -->
    <ImageView
        android:id="@+id/backdrop_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/backdrop_content_description"
        tools:src="@drawable/app_banner" />

    <!-- Left scrim overlay -->
    <View
        android:id="@+id/scrim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_gradient_left_strong" />

    <!-- Content container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|start"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:maxWidth="600dp">

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="48sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="16dp"
            tools:text="Example Movie Title" />

        <!-- Metadata row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <!-- Type badge -->
            <TextView
                android:id="@+id/content_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/md_theme_primary"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="16dp"
                tools:text="MOVIE" />

            <!-- Rating -->
            <TextView
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/btn_star_big_on"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                tools:text="8.5" />

        </LinearLayout>

        <!-- Overview -->
        <TextView
            android:id="@+id/overview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:lineSpacingExtra="6dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="24dp"
            android:alpha="0.9"
            tools:text="This is an example overview text that describes the content. It should be readable over the busy background image thanks to the left scrim gradient overlay." />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/play_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ Play"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@color/md_theme_primary"
                android:layout_marginEnd="16dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp" />

            <Button
                android:id="@+id/more_info_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ More Info"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@color/md_theme_surface"
                android:layout_marginEnd="16dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp" />

            <Button
                android:id="@+id/watchlist_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ My List"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@color/md_theme_surface"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
